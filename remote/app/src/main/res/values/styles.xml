<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Remote" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#E3C78C</item>
        <item name="android:colorPrimary">#14120F</item>
        <item name="android:colorPrimaryDark">#0B0A09</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#0B0A09</item>
    </style>
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">#E3C78C</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
